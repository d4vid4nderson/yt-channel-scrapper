// Copy to Local.xcconfig and fill in. Local.xcconfig is gitignored so the repo does not
// carry a team id. Find the team id at developer.apple.com → Membership.
DEVELOPMENT_TEAM = ABCDE12345

// Optional. Only needed if com.moregroup.ytchannelscraper is taken on your account, or
// if you are signing with a team that already has that id spoken for.
YTCS_BUNDLE_ID = com.moregroup.ytchannelscraper
