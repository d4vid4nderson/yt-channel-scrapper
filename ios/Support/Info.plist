	<array>
		<dict>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeDescription</key>
			<string>YT Parent Command Center Library</string>
			<key>UTTypeIdentifier</key>
			<string>com.d4vid4nderson.ytchannelscraper.library</string>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>ytcslibrary</string>
				</array>
			</dict>
		</dict>
	</array>
