# Copy to Local.release.env (gitignored) and fill in. This is what lets release.sh upload
# to TestFlight with nobody at the keyboard.
#
# App Store Connect -> Users and Access -> Integrations -> App Store Connect API
#   -> generate a key with the App Manager role.
#   -> the Key ID and Issuer ID are on that page; the .p8 downloads once and only once.
#
# Apple's tools look for the key in ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8,
# so putting it there means ASC_KEY_PATH can be left alone.
ASC_KEY_ID=
ASC_ISSUER_ID=
# ASC_KEY_PATH=~/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8

# Ad hoc only: where the .ipa and manifest.plist will be served from, over HTTPS.
# YTCS_MANIFEST_BASE_URL=https://downloads.example.com/ytcs
